name: Build Sovereign AI Node (Windows / macOS / Linux)

on:
  push:
    branches: [ main, master ]
  workflow_dispatch:

env:
  PYTHON_VERSION: '3.11'
  APP_NAME: 'SovereignAI-Node'

jobs:
  build:
    strategy:
      # fail-fast: false يعني لو فشل بناء منصة واحدة (مثلاً Windows)، الاثنتان
      # الأخريان يكملان بناءهما بدل ما يتوقف كل شيء فوراً. مفيد جداً بما أن
      # Windows وmacOS لم يُختبرا محلياً بعد وقد يحتاجان تصحيحات لاحقة.
      fail-fast: false
      matrix:
        include:
          - os: ubuntu-22.04
            platform: linux
            artifact_ext: tar.gz
          - os: windows-2022
            platform: windows
            artifact_ext: zip
          - os: macos-13
            platform: macos
            artifact_ext: zip

    runs-on: ${{ matrix.os }}

    steps:
      - name: Checkout Code
        uses: actions/checkout@v4

      - name: Set up Python
        uses: actions/setup-python@v5
        with:
          python-version: ${{ env.PYTHON_VERSION }}
          cache: 'pip'

      # ===================================================
      # اعتماديات نظام التشغيل — تختلف جذرياً بين المنصات لأن
      # pywebview يستخدم backend مختلف تماماً على كل نظام:
      # Linux → GTK/WebKit2GTK (يحتاج مكتبات نظام صريحة)
      # Windows → Edge WebView2 (غالباً مثبّت مسبقاً على runner)
      # macOS → WebKit الأصلي لنظام macOS (لا يحتاج تثبيت إضافي)
      # ===================================================
      - name: Install System Dependencies (Linux)
        if: matrix.platform == 'linux'
        run: |
          sudo apt-get update
          sudo apt-get install -y \
            python3-gi python3-gi-cairo gir1.2-gtk-3.0 gir1.2-webkit2-4.1 \
            libgirepository1.0-dev libcairo2-dev libgtk-3-0 libwebkit2gtk-4.1-0 \
            libjpeg-dev zlib1g-dev libpng-dev libsqlite3-dev libssl-dev libffi-dev \
            pkg-config build-essential curl wget

      - name: Ensure WebView2 Runtime Reference (Windows)
        if: matrix.platform == 'windows'
        run: |
          echo "WebView2 Runtime is preinstalled on windows-2022 GitHub runners."
          echo "pywebview will use it automatically as the Windows backend; no extra install needed here."

      - name: Install System Dependencies (macOS)
        if: matrix.platform == 'macos'
        run: |
          echo "macOS uses the native system WebKit via pywebview; no extra system packages required."

      # ===================================================
      # اعتماديات Python — نفس requirements.txt للثلاثة، لكن نضيف
      # حزمة pywebview[qt] فقط على Linux لأنها المطلوبة هناك تحديداً
      # (على Windows/macOS pywebview يستخدم backend النظام الأصلي مباشرة)
      # ===================================================
      - name: Install Python Dependencies
        run: |
          python -m pip install --upgrade pip wheel
          pip install -r requirements.txt
          pip install --upgrade setuptools

      # ===================================================
      # تحميل ملفات الواجهة الثابتة (offline assets) — نفس الخطوة
      # للثلاثة، لضمان عمل التطبيق دون إنترنت بعد التثبيت.
      # نستخدم curl على الثلاثة (متوفر افتراضياً على كل GitHub runners،
      # بما فيها windows-2022 عبر curl.exe المدمج).
      # ===================================================
      - name: Download Static Files (Offline CSS/JS)
        shell: bash
        run: |
          echo "Creating static directory and downloading UI files..."
          mkdir -p static
          curl -s -L -o static/tailwind.min.js https://cdn.tailwindcss.com
          curl -s -L -o static/material-symbols-rounded.css "https://fonts.googleapis.com/css2?family=Material+Symbols+Rounded:opsz,wght,FILL,GRAD@24,400,0,0"

      # ===================================================
      # بناء الملف التنفيذي — الفروقات الجوهرية بين المنصات:
      # 1. فاصل --add-data: ":" على Linux/macOS، ";" على Windows
      # 2. صيغة الأيقونة: .png (Linux) / .ico (Windows) / .icns (macOS)
      # 3. --collect-all PyQt5/PyQtWebEngine/qtpy فقط على Linux
      #    (هذه حزم backend خاصة بـ GTK/Qt، غير مستخدَمة على Windows/macOS
      #    حيث يستخدم pywebview الـ WebView الأصلي للنظام مباشرة)
      # ===================================================
      - name: Build Single Executable File (Linux)
        if: matrix.platform == 'linux'
        run: |
          pyinstaller --noconfirm --onefile --windowed --name="${{ env.APP_NAME }}" \
            --add-data "templates:templates" \
            --add-data "static:static" \
            --add-data "app_icon.png:." \
            --collect-all fastapi \
            --collect-all uvicorn \
            --collect-all pydantic \
            --collect-all httpx \
            --collect-all pywebview \
            --collect-all PyQt5 \
            --collect-all PyQtWebEngine \
            --collect-all qtpy \
            --collect-all chromadb \
            --collect-all tqdm \
            --collect-all jinja2 \
            --collect-all jaraco \
            --collect-all zeroconf \
            --collect-submodules pkg_resources \
            --hidden-import=uvicorn.logging \
            --hidden-import=uvicorn.loops \
            --hidden-import=uvicorn.loops.auto \
            --hidden-import=uvicorn.protocols \
            --hidden-import=uvicorn.protocols.http \
            --hidden-import=uvicorn.protocols.http.auto \
            --hidden-import=uvicorn.protocols.websockets \
            --hidden-import=uvicorn.protocols.websockets.auto \
            --hidden-import=uvicorn.lifespan \
            --hidden-import=uvicorn.lifespan.on \
            --icon="app_icon.png" app.py

      - name: Build Single Executable File (Windows)
        if: matrix.platform == 'windows'
        shell: cmd
        run: |
          pyinstaller --noconfirm --onefile --windowed --name="%APP_NAME%" ^
            --add-data "templates;templates" ^
            --add-data "static;static" ^
            --add-data "app_icon.png;." ^
            --collect-all fastapi ^
            --collect-all uvicorn ^
            --collect-all pydantic ^
            --collect-all httpx ^
            --collect-all pywebview ^
            --collect-all chromadb ^
            --collect-all tqdm ^
            --collect-all jinja2 ^
            --collect-all jaraco ^
            --collect-all zeroconf ^
            --collect-submodules pkg_resources ^
            --hidden-import=uvicorn.logging ^
            --hidden-import=uvicorn.loops ^
            --hidden-import=uvicorn.loops.auto ^
            --hidden-import=uvicorn.protocols ^
            --hidden-import=uvicorn.protocols.http ^
            --hidden-import=uvicorn.protocols.http.auto ^
            --hidden-import=uvicorn.protocols.websockets ^
            --hidden-import=uvicorn.protocols.websockets.auto ^
            --hidden-import=uvicorn.lifespan ^
            --hidden-import=uvicorn.lifespan.on ^
            --icon="app_icon.ico" app.py

      - name: Build Single Executable File (macOS)
        if: matrix.platform == 'macos'
        run: |
          pyinstaller --noconfirm --onefile --windowed --name="${{ env.APP_NAME }}" \
            --add-data "templates:templates" \
            --add-data "static:static" \
            --add-data "app_icon.png:." \
            --collect-all fastapi \
            --collect-all uvicorn \
            --collect-all pydantic \
            --collect-all httpx \
            --collect-all pywebview \
            --collect-all chromadb \
            --collect-all tqdm \
            --collect-all jinja2 \
            --collect-all jaraco \
            --collect-all zeroconf \
            --collect-submodules pkg_resources \
            --hidden-import=uvicorn.logging \
            --hidden-import=uvicorn.loops \
            --hidden-import=uvicorn.loops.auto \
            --hidden-import=uvicorn.protocols \
            --hidden-import=uvicorn.protocols.http \
            --hidden-import=uvicorn.protocols.http.auto \
            --hidden-import=uvicorn.protocols.websockets \
            --hidden-import=uvicorn.protocols.websockets.auto \
            --hidden-import=uvicorn.lifespan \
            --hidden-import=uvicorn.lifespan.on \
            --icon="app_icon.icns" app.py

      # ===================================================
      # اختصار سطح المكتب — Linux فقط (macOS/Windows المستخدم يشغّل
      # الملف التنفيذي مباشرة أو ينشئ اختصاره يدوياً بسهولة من الواجهة)
      # ===================================================
      - name: Create Linux Desktop Shortcut
        if: matrix.platform == 'linux'
        run: |
          cat <<EOF > dist/SovereignAI.desktop
          [Desktop Entry]
          Version=1.0
          Type=Application
          Name=Sovereign AI Node
          Comment=Sovereign AI Enterprise Local Node
          Exec=sh -c "QT_XCB_GL_INTEGRATION=none LIBGL_ALWAYS_SOFTWARE=1 \\\$(dirname %k)/${{ env.APP_NAME }}"
          Icon=\\\$(dirname %k)/app_icon.png
          Terminal=false
          Categories=Development;Science;IDE;
          EOF
          chmod +x dist/SovereignAI.desktop
          cp app_icon.png dist/ || true

      # ===================================================
      # تجهيز حزمة macOS: نسخ الأيقونة للأرشيف (مفيدة كمرجع بصري
      # للمستخدم حتى لو التطبيق onefile ولا ينشئ حزمة .app كاملة)
      # ===================================================
      - name: Prepare macOS Package Contents
        if: matrix.platform == 'macos'
        run: |
          cp app_icon.icns dist/ || true
          cp app_icon.png dist/ || true

      - name: Prepare Windows Package Contents
        if: matrix.platform == 'windows'
        shell: cmd
        run: |
          copy app_icon.ico dist\ 2>nul || exit 0
          copy app_icon.png dist\ 2>nul || exit 0

      # ===================================================
      # ضغط الناتج — tar.gz على Linux (يحافظ على صلاحيات chmod +x)،
      # zip على Windows/macOS (الصيغة الأكثر ألفة للمستخدمين هناك)
      # ===================================================
      - name: Archive Build (Linux)
        if: matrix.platform == 'linux'
        run: |
          cd dist
          tar -czvf ${{ env.APP_NAME }}-linux.tar.gz ${{ env.APP_NAME }} SovereignAI.desktop app_icon.png

      - name: Archive Build (Windows)
        if: matrix.platform == 'windows'
        shell: pwsh
        run: |
          Compress-Archive -Path dist\* -DestinationPath "${{ env.APP_NAME }}-windows.zip"

      - name: Archive Build (macOS)
        if: matrix.platform == 'macos'
        run: |
          cd dist
          zip -r "../${{ env.APP_NAME }}-macos.zip" .

      - name: Upload Artifact (Linux)
        if: matrix.platform == 'linux'
        uses: actions/upload-artifact@v4
        with:
          name: ${{ env.APP_NAME }}-linux
          path: dist/${{ env.APP_NAME }}-linux.tar.gz

      - name: Upload Artifact (Windows)
        if: matrix.platform == 'windows'
        uses: actions/upload-artifact@v4
        with:
          name: ${{ env.APP_NAME }}-windows
          path: ${{ env.APP_NAME }}-windows.zip

      - name: Upload Artifact (macOS)
        if: matrix.platform == 'macos'
        uses: actions/upload-artifact@v4
        with:
          name: ${{ env.APP_NAME }}-macos
          path: ${{ env.APP_NAME }}-macos.zip
